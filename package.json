{
  "name": "ts-hexagram-generator",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Yijing hexagram oracle (yarrow stalk method) — Turborepo + pnpm workspaces root",
  "author": "Lim Jiechao <jiechao.lim@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/limjiechao/ts-hexagram-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limjiechao/ts-hexagram-generator.git"
  },
  "keywords": [
    "hexagram",
    "i ching",
    "yarrow stalks",
    "yarrow stalk method",
    "yijing"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "type:check": "turbo run type:check",
    "lint:check": "oxlint && eslint --cache .",
    "lint:fix": "oxlint --fix && eslint --cache . --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "hexagram-random": "tsx apps/cli/src/random.ts",
    "hexagram-interactive": "tsx apps/cli/src/interactive.ts",
    "generate-json-files": "turbo run generate-json-files --filter=@hexagram/core",
    "generate-fixtures": "turbo run generate-fixtures --filter=@hexagram/viewer-ui"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.1.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "bumpp": "^11.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-oxlint": "^1.64.0",
    "ink": "^7.0.3",
    "ink-testing-library": "^4.0.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "react": "^19.2.6",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
