{
  "name": "@hexagram/shell",
  "type": "module",
  "version": "0.0.0",
  "description": "Composed terminal app for the Yijing hexagram oracle: a Home hub that navigates between the casting and history flows",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hexagram/casting-ui": "workspace:*",
    "@hexagram/consultation-file": "workspace:*",
    "@hexagram/core": "workspace:*",
    "@hexagram/history-ui": "workspace:*",
    "@hexagram/playground-ui": "workspace:*",
    "@hexagram/viewer-core": "workspace:*",
    "ink": "^7.0.3",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@hexagram/test-utils": "workspace:*",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0"
  }
}
