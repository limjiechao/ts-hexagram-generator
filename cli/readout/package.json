{
  "name": "@hexagram/readout",
  "type": "module",
  "version": "0.0.0",
  "description": "Consultation Readout renderer for the Yijing hexagram oracle: the tabbed readout component plus the per-section ANSI string builders",
  "license": "MIT",
  "exports": {
    "./consultation-readout": {
      "source": "./src/consultation-readout.tsx",
      "types": "./dist/consultation-readout.d.mts",
      "import": "./dist/consultation-readout.mjs"
    },
    "./output-composers": {
      "source": "./src/output-composers.ts",
      "types": "./dist/output-composers.d.mts",
      "import": "./dist/output-composers.mjs"
    },
    "./serialize-ansi": {
      "source": "./src/serialize-ansi.ts",
      "types": "./dist/serialize-ansi.d.mts",
      "import": "./dist/serialize-ansi.mjs"
    },
    "./standing-line-color": {
      "source": "./src/standing-line-color.ts",
      "types": "./dist/standing-line-color.d.mts",
      "import": "./dist/standing-line-color.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hexagram/consultation-view": "workspace:*",
    "@hexagram/core": "workspace:*",
    "@hexagram/text-layout": "workspace:*",
    "@hexagram/viewer-core": "workspace:*",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "slice-ansi": "^9.0.0"
  },
  "devDependencies": {
    "@hexagram/test-utils": "workspace:*",
    "@types/react": "^19.2.14",
    "ink-testing-library": "^4.0.0"
  }
}
