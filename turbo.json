{
  "$schema": "https://turbo.build/schema.json",
  // Topological build/type:check order: docs/adr/0002-monorepo-structure-and-package-decomposition.md
  // test env (FORCE_COLOR) + cache posture: docs/adr/0013-test-execution-and-ci-posture.md
  "tasks": {
    "//#check:affected": {},
    "//#format:check": {},
    "//#format:fix": {
      "cache": false
    },
    "//#lint:check": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#boundaries:check": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["FORCE_COLOR"]
    },
    "type:check": {
      "dependsOn": ["^build"]
    },
    "generate-fixtures": {
      "cache": false
    },
    "generate-json-files": {
      "cache": false
    }
  }
}
