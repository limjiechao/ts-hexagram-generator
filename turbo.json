{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "type:check": {
      "dependsOn": ["^build"]
    },
    "generate-fixtures": {
      "cache": false
    },
    "generate-json-files": {
      "cache": false
    }
  }
}
