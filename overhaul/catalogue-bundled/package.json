{
  "name": "@hexagram/catalogue-bundled",
  "type": "module",
  "version": "0.0.0",
  "description": "The bundled Scripture Catalogue: every Edition's names and passage texts as literal data, with its Witness and licence, shared by the CLI and the REST engine (ADR-0028, ADR-0037)",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./bundled-scripture-catalogue": {
      "source": "./src/bundled-scripture-catalogue.ts",
      "types": "./dist/bundled-scripture-catalogue.d.mts",
      "import": "./dist/bundled-scripture-catalogue.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hexagram/application": "workspace:*",
    "@hexagram/oracle": "workspace:*",
    "@hexagram/scripture-catalogue": "workspace:*"
  }
}
