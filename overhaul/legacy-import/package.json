{
  "name": "@hexagram/legacy-import",
  "type": "module",
  "version": "0.0.0",
  "description": "The legacy import: an anti-corruption layer reading pre-overhaul files, legacy .txt and version-1 .md, as Cast or Recorded Consultations' records, shared by the CLI and the PWA (ADR-0026, ADR-0037)",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./parse-legacy": {
      "source": "./src/parse-legacy.ts",
      "types": "./dist/parse-legacy.d.mts",
      "import": "./dist/parse-legacy.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hexagram/application": "workspace:*",
    "@hexagram/consultation-journal": "workspace:*",
    "@hexagram/oracle": "workspace:*",
    "js-yaml": "^3.14.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^3.12.10"
  }
}
