{
  "name": "@hexagram/scripture-catalogue",
  "type": "module",
  "version": "0.0.0",
  "description": "The Scripture Catalogue (supporting domain): Works, their Citations and Editions, and how a reader wants them shown",
  "license": "MIT",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./citation": {
      "source": "./src/citation.ts",
      "types": "./dist/citation.d.mts",
      "import": "./dist/citation.mjs"
    },
    "./default-reading-preference": {
      "source": "./src/default-reading-preference.ts",
      "types": "./dist/default-reading-preference.d.mts",
      "import": "./dist/default-reading-preference.mjs"
    },
    "./edition": {
      "source": "./src/edition.ts",
      "types": "./dist/edition.d.mts",
      "import": "./dist/edition.mjs"
    },
    "./edition-id": {
      "source": "./src/edition-id.ts",
      "types": "./dist/edition-id.d.mts",
      "import": "./dist/edition-id.mjs"
    },
    "./hexagram-name": {
      "source": "./src/hexagram-name.ts",
      "types": "./dist/hexagram-name.d.mts",
      "import": "./dist/hexagram-name.mjs"
    },
    "./passage-text": {
      "source": "./src/passage-text.ts",
      "types": "./dist/passage-text.d.mts",
      "import": "./dist/passage-text.mjs"
    },
    "./reading-preference": {
      "source": "./src/reading-preference.ts",
      "types": "./dist/reading-preference.d.mts",
      "import": "./dist/reading-preference.mjs"
    },
    "./work": {
      "source": "./src/work.ts",
      "types": "./dist/work.d.mts",
      "import": "./dist/work.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hexagram/consultation-journal": "workspace:*",
    "@hexagram/oracle": "workspace:*"
  }
}
