{
  "name": "@hexagram/core",
  "type": "module",
  "version": "0.0.0",
  "description": "Yijing hexagram oracle: yarrow stalk algorithm, random generators, getters, and canonical hexagram/trigram records",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./random": {
      "source": "./src/random.ts",
      "types": "./dist/random.d.mts",
      "import": "./dist/random.mjs"
    },
    "./getters": {
      "source": "./src/getters.ts",
      "types": "./dist/getters.d.mts",
      "import": "./dist/getters.mjs"
    },
    "./hexagrams": {
      "source": "./src/models/hexagrams.ts",
      "types": "./dist/models/hexagrams.d.mts",
      "import": "./dist/models/hexagrams.mjs"
    },
    "./trigrams": {
      "source": "./src/models/trigrams.ts",
      "types": "./dist/models/trigrams.d.mts",
      "import": "./dist/models/trigrams.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "cross-env FORCE_COLOR=1 vitest run --passWithNoTests",
    "type:check": "tsc --noEmit",
    "generate-json-files": "tsx scripts/generate-json-files.ts && oxfmt --write src/models/*.json"
  },
  "dependencies": {
    "@hexagram/types": "workspace:*"
  }
}
